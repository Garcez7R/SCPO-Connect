{
	auto_https disable_redirects
	default_sni {$SCPO_INTERNAL_HOST:localhost}
}

http://{$SCPO_INTERNAL_HOST:localhost} {
	handle /scpo-root-ca.crt {
		rewrite * /root.crt
		root * /data/caddy/pki/authorities/local
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle {
		redir https://{$SCPO_INTERNAL_HOST:localhost}:{$SCPO_HTTPS_PORT:8443}{uri} 308
	}
}

{$SCPO_INTERNAL_HOST:localhost} {
	tls internal

	@auth path /api/v1/auth/*
	handle @auth {
		reverse_proxy access:8000
	}

	@access path /api/v1/access/*
	handle @access {
		reverse_proxy access:8000
	}

	@system_admin path /api/v1/system-admin/*
	handle @system_admin {
		reverse_proxy access:8000
	}

	@audit path /api/v1/audit/*
	handle @audit {
		reverse_proxy audit:8000
	}

	@nursing path /api/v1/nursing/*
	handle @nursing {
		reverse_proxy nursing:8000
	}

	@reception path /api/v1/reception/*
	handle @reception {
		reverse_proxy nursing:8000
	}

	@pharmacy path /api/v1/pharmacy/*
	handle @pharmacy {
		reverse_proxy pharmacy:8000
	}

	@social path /api/v1/social/*
	handle @social {
		reverse_proxy social:8000
	}

	@psychology path /api/v1/psychology/*
	handle @psychology {
		reverse_proxy social:8000
	}

	@xray path /api/v1/xray/*
	handle @xray {
		reverse_proxy xray:8000
	}

	@maintenance path /api/v1/maintenance/*
	handle @maintenance {
		reverse_proxy maintenance:8000
	}

	@hygiene path /api/v1/hygiene/*
	handle @hygiene {
		reverse_proxy maintenance:8000
	}

	@therapy path /api/v1/therapy/*
	handle @therapy {
		reverse_proxy therapy:8000
	}

	@backup path /api/v1/backup/*
	handle @backup {
		reverse_proxy backup:8000
	}

	handle {
		reverse_proxy web:80
	}
}
